# 环境变量示例。复制成 .env 后按需修改，.env 已在 .gitignore 里。
#
# 这个项目默认不需要任何密钥 —— 靶场是本地的，博客是自己的。
# 下面这些只是让同一份代码能指向别的环境。

# 靶场地址（也可以在命令行用 --dojo 覆盖）
DOJO_BASE_URL=http://127.0.0.1:8000

# 真实战场：博客地址。改成你自己的站也能跑第 10 章。
BLOG_BASE_URL=https://blog.djdj45.top

# 数据库。默认落本地 SQLite（data/ 目录已在 .gitignore 里）。
# 换 PostgreSQL / MySQL 只改这一行，代码不用动 —— 这是 ORM 唯一值得付的代价。
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/crawler
#   DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/crawler
# DATABASE_URL=sqlite:///data/dojo.db
